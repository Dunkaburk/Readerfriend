{
  "name": "readerfriend",
  "private": true,
  "version": "0.1.0",
  "description": "Personal ebook reader with AI-generated audiobook narration",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,toml,yaml}\"",
    "deploy": "pnpm --filter api deploy"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
